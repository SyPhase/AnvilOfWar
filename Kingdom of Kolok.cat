    <profile name="Charge" typeId="7e76-2916-e877-fd40" typeName="Active (Special Abilities)" hidden="false" id="da7d-932f-71c1-2be3">
      <characteristics>
        <characteristic name="Description" typeId="3437-636f-e6aa-d7ea">You may only use this ability if no enemy squads are within range of melee weapons in this squad and at least one enemy squad is within 9”. Roll a D6. If performing a move of that many inches would put this squad within range of an enemy squad with a melee weapon, you may perform a move of that many inches ending within range of that enemy squad with a melee weapon. Then, make an attack with one of this squad’s melee weapon profiles.</characteristic>
      </characteristics>
    </profile>
    <profile name="Prescient Warning" typeId="4720-4964-f773-3509" typeName="Passive (Special Abilities)" hidden="false" id="4556-2a02-3c47-2a0b">
      <characteristics>
        <characteristic name="Description" typeId="bc7d-10a5-15e8-e96d">Friendly squads within 12” of this squad have the passive ability stealthy.</characteristic>
